# Configuração local — copie para .env (fora do Git)
# Porta e bind
PORT=3040
HOST=127.0.0.1

# Banco SQLite
DB_PATH=./data/pulso.sqlite

# Pluggy — credenciais da aplicação
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
# Item já conectado (opcional na F0; obrigatório para /api/sync/run)
PLUGGY_ITEM_ID=
# Segredo aleatório para autenticar o webhook de entrada
PLUGGY_WEBHOOK_BEARER_TOKEN=
